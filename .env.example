# Copiar a .env en la raíz del repo (local) o a ~/app/.env (VPS). Nunca subir .env al repositorio.

# --- Dominio y despliegue ---
DOMAIN=chatinit.example.com
# Dueño y nombre del repo en minúsculas, como los nombres de imagen en GHCR
GHCR_OWNER=usuario-en-minusculas
REPO_NAME=red-social
IMAGE_TAG=latest

# --- Base de datos ---
POSTGRES_USER=app
POSTGRES_PASSWORD=cambiar-por-una-clave-larga
POSTGRES_DB=minired
# Local: postgresql://app:app@localhost:5432/minired
DATABASE_URL=postgresql://app:app@localhost:5432/minired

# --- Autenticación ---
JWT_ACCESS_SECRET=generar-con-openssl-rand-base64-48
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- API ---
PORT=3000
CORS_ORIGIN=http://localhost:3001

# --- Respaldos (solo VPS, S2-02) ---
# Comando que recibe la ruta del respaldo y lo copia fuera del servidor; vacío = solo local
BACKUP_UPLOAD_CMD=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frontend (en local, copiar también a apps/web/.env.local) ---
API_INTERNAL_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Solo en local: la web (:3001) se conecta directo a la api para Socket.io. En producción, vacía (mismo dominio).
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
