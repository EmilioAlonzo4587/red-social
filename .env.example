# Copiar a .env (local) o a infra/.env (VPS). Nunca subir .env al repositorio.

# --- Dominio y despliegue ---
DOMAIN=mired.example.com
GHCR_OWNER=organizacion-o-usuario
REPO_NAME=chatinit
IMAGE_TAG=latest

# --- Base de datos ---
POSTGRES_USER=app
POSTGRES_PASSWORD=cambiar-por-una-clave-larga
POSTGRES_DB=minired
# Local: postgresql://app:app@localhost:5432/minired
DATABASE_URL=postgresql://app:app@localhost:5432/minired

# --- Autenticación ---
JWT_ACCESS_SECRET=generar-con-openssl-rand-base64-48
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- API ---
PORT=3000
CORS_ORIGIN=http://localhost:3001

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frontend ---
API_INTERNAL_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
